# Centrum Bolotova — production rewrite rules (Apache / LiteSpeed on HostCreators).
# GitHub Pages ignores this file; it only takes effect on the SFTP-deployed host.

# ── Custom error page ────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Hardening ────────────────────────────────────────────────────────────────
# Don't expose directory contents when there's no index file.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Force HTTPS (redirect any http:// request to https://) ───────────────────
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ── Clean API URLs: /api/<name> -> /api/<name>.php  (e.g. /api/order, /api/stripe-webhook).
  # Only when the request isn't a real file/dir AND the .php target exists.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/api/$1.php -f
  RewriteRule ^api/([a-z0-9_-]+)/?$ api/$1.php [L]

  # ── Clean page URLs (hide the .html) ─────────────────────────────────────────
  # 1) /index.html (or /index) -> the root.
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # 2) /page.html -> /page  (301, so the address bar shows the clean URL).
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 3) Serve /page internally from page.html (no redirect, no .html shown).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+?)/?$ $1.html [L]
</IfModule>

# ── Security headers ───────────────────────────────────────────────────────────
# Sent with every response. CSP (Content-Security-Policy) is intentionally NOT set
# here yet — it needs careful whitelisting of GTM/GA4/Stripe/fonts and testing on
# the live site, so it's a separate task to avoid breaking analytics/checkout.
<IfModule mod_headers.c>
  # Always use HTTPS for a year (browsers ignore this header over plain HTTP).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Don't let browsers guess (sniff) a file's type — blocks a class of attacks.
  Header always set X-Content-Type-Options "nosniff"
  # Disallow embedding our pages in other sites' frames (anti-clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Send only the origin (not the full path) as referrer to other sites.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Turn off browser features the site doesn't use.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>
